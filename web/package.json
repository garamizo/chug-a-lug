    "@types/node": "^22.20.4",
    "@vite-pwa/sveltekit": "^1.1.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
