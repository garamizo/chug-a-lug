# Copy to .env. Use unique superuser credentials; do not commit this file's filled copy.
# PocketBase: internal address for server scripts; browser URL must be reachable on the phone.
PB_URL=http://127.0.0.1:8090
PUBLIC_PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=admin@chugalug.app
PB_ADMIN_PASSWORD=

# Shared passwords handed out by the admin. CREW_PASSWORD is required; ADMIN_PASSWORD grants Conductor rights.
CREW_PASSWORD=
ADMIN_PASSWORD=

# Production: PUBLIC_PB_URL=https://pb.chugalug.app, ORIGIN=https://chugalug.app
CLOUDFLARE_TUNNEL_TOKEN=
ORIGIN=http://localhost:3000
BACKUP_DIR=./data/backups

# Shared secret between PocketBase hooks and the SvelteKit server (any long random string).
INTERNAL_SECRET=
# Where PocketBase reaches the SvelteKit server. Dev: http://127.0.0.1:5173. Compose sets http://web:3000.
WEB_INTERNAL_URL=http://127.0.0.1:5173

# Google Places (server-side only). Leave empty to plan without venue photos.
GOOGLE_PLACES_KEY=
# Optional overrides. DATA_DIR defaults to ../data in dev and /data in the container.
# GTFS_URL=https://schedules.metrarail.com/gtfs/schedule.zip
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# DATA_DIR=

# Later milestones.
# Metra realtime (M2). Bearer token for gtfspublic.metrarr.com; the copy in .secrets/ is git-ignored.
# Leave empty to run on the static timetable alone: the app then says "Timetable only".
METRA_API_TOKEN=
# METRA_RT_BASE=https://gtfspublic.metrarr.com/gtfs/public
# Regular just up defaults to shared practice. Set 0 and run just up for the real event.
REHEARSAL=1
# Direct local development only; just up sets both simulation flags for the selected mode.
SIM=0
