# Optional: copy to .env.sim. Only these five settings are accepted.
# Run credentials are generated per run; never paste production credentials here.
WEB_PORT=15174
PB_PORT=18094
BIND_HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:15174
PB_ORIGIN=http://127.0.0.1:18094
# For LAN phone checks: BIND_HOST=0.0.0.0 and use this machine's LAN IP in BOTH origins.
# LAN HTTP is for functional checks only. PWA/offline phone checks need dedicated HTTPS origins.
